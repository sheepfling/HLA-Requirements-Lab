{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/state_machine.schema.json",
  "title": "Canonical state-machine source file",
  "type": "object",
  "required": ["schema_version", "state_machines"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 2 },
    "state_machines": {
      "type": "array",
      "items": { "$ref": "#/$defs/state_machine" }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["path", "line"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "xref": { "type": ["string", "null"] },
        "caption": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "parent_id": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source_ref" }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
              "properties": { "kind": { "enum": ["initial", "final", "history"] } }
          },
          "then": {},
          "else": { "properties": { "label": { "minLength": 1 } } }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["id", "source_state", "event", "target_state"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_state": { "type": ["string", "null"] },
        "event": { "type": "string" },
        "target_state": { "type": ["string", "null"] },
        "initiator": { "enum": ["federate", "rti", "automatic", "unknown"] },
        "guard": { "type": "string" },
        "action": { "type": "string" },
        "precondition": { "type": "string" },
        "postcondition": { "type": "string" },
        "clause_id": { "type": ["string", "null"] },
        "requirement_ids": { "type": "array", "items": { "type": "string" } },
        "implementation_ids": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source_ref" }
      }
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "visible": { "type": "boolean", "default": true }
      }
    },
    "transition_layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["straight", "bend-left", "bend-right", "loop"] },
        "loop_direction": { "enum": ["left", "right", "above", "below"] },
        "bend": { "type": "number", "minimum": 0, "maximum": 180 },
        "label_side": { "enum": ["above", "below", "left", "right"] },
        "label_pos": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string" },
        "label_x": { "type": "number" },
        "label_y": { "type": "number" },
        "label_width": { "type": "number", "exclusiveMinimum": 0 },
        "label_align": { "enum": ["left", "center", "right"] },
        "label_visible": { "type": "boolean", "default": true }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "enum": ["automatic", "manual"] },
        "direction": { "enum": ["left-to-right", "top-to-bottom"] },
        "state_font": { "enum": ["tiny", "scriptsize", "small"] },
        "edge_label_font": { "enum": ["tiny", "scriptsize", "small"] },
        "edge_label_distance": { "type": "number", "minimum": 0 },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y", "width", "height", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "title": { "type": "string", "minLength": 1 },
              "visible": { "type": "boolean", "default": true },
              "title_visible": { "type": "boolean", "default": true }
            }
          }
        },
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/position" }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "additionalProperties": false,
            "properties": {
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" },
              "style": { "enum": ["solid", "dashed"] }
            }
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "text": { "type": "string", "minLength": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "align": { "enum": ["left", "center", "right"] }
            }
          }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/transition_layout" }
        }
      }
    },
    "state_machine": {
      "type": "object",
      "required": ["id", "title", "states", "transitions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "clause_id": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source_ref" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "initial_state_ids": { "type": "array", "items": { "type": "string" } },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "layout": { "$ref": "#/$defs/layout" },
        "notes": { "type": "string" }
      }
    }
  }
}
