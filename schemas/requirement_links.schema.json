{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/requirement_links.schema.json",
  "title": "Authored requirement-to-transition links",
  "type": "object",
  "required": [
    "schema_version",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "requirement_id",
        "transition_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "governs",
            "precondition",
            "postcondition",
            "enables",
            "prohibits"
          ]
        },
        "source": {
          "$ref": "#/$defs/source_ref"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
