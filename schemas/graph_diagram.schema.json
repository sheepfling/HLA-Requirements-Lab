{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/graph_diagram.schema.json",
  "title": "Canonical generic graph-diagram source file",
  "type": "object",
  "required": [
    "schema_version",
    "graph_diagrams"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "graph_diagrams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph_diagram"
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "image",
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "xref": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "style": {
          "enum": [
            "box",
            "frame",
            "lifeline",
            "ellipse",
            "point",
            "invisible"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "style": {
          "enum": [
            "solid",
            "dotted",
            "dashed",
            "dimension"
          ]
        },
        "direction": {
          "enum": [
            "none",
            "forward",
            "reverse",
            "both"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "clause_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "rotate": {
          "type": "number"
        }
      }
    },
    "graph_diagram": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "relationship",
            "conceptual",
            "hierarchy",
            "architecture"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "clause_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/source_ref"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
