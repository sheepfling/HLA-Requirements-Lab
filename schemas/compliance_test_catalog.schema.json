{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/compliance_test_catalog.schema.json",
  "title": "RTI compliance test catalog",
  "description": "RTI-owned mapping from stable behavioral tests to corpus implementation seams.",
  "type": "object",
  "required": [
    "schema_version",
    "tests"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "runner",
        "selector",
        "result_selector",
        "document_id",
        "implementation_mapping_id",
        "target",
        "language",
        "symbol",
        "api_surface_ids",
        "execution_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable evidence ID referenced by an implementation binding."
        },
        "kind": {
          "enum": [
            "unit-test",
            "integration-test",
            "trace",
            "compile",
            "build"
          ]
        },
        "runner": {
          "type": "string",
          "minLength": 1,
          "description": "Runner name, for example catch2, ctest, junit5, maven, or gradle."
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "description": "Stable runner-specific test name, tag, filter, or selector."
        },
        "result_selector": {
          "type": "string",
          "minLength": 1,
          "description": "Exact JUnit XML testcase selector: name, classname#name, or classname.name."
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation_mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "description": "RTI-owned implementation symbol exercised by this test."
        },
        "api_surface_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_mode": {
          "enum": [
            "real",
            "mocked",
            "simulated",
            "unknown"
          ],
          "description": "Whether the test exercised a real RTI integration boundary."
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
