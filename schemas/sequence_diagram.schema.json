{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/sequence_diagram.schema.json",
  "title": "Canonical message-sequence diagram source file",
  "type": "object",
  "required": ["schema_version", "sequence_diagrams"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "sequence_diagrams": {
      "type": "array",
      "items": { "$ref": "#/$defs/sequence_diagram" }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["path", "line"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "xref": { "type": ["string", "null"] },
        "caption": { "type": "string" }
      }
    },
    "participant": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "required": ["id", "order", "source_participant", "target_participant", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "source_participant": { "type": "string", "minLength": 1 },
        "target_participant": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["message", "request", "response", "control", "note"] },
        "response_to": { "type": ["string", "null"] },
        "clause_id": { "type": ["string", "null"] },
        "requirement_ids": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source_ref" }
      }
    },
    "sequence_diagram": {
      "type": "object",
      "required": ["id", "title", "participants", "messages"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/participant" }
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "clause_id": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source_ref" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
