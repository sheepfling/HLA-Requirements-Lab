{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-recreation.local/schemas/corpus_bundle.schema.json",
  "$defs": {
    "BundleCrosswalk": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "implementation_mapping_id": {
          "minLength": 1,
          "title": "Implementation Mapping Id",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "binding_kind": {
          "enum": [
            "native",
            "protocol",
            "language-adapter",
            "transport"
          ],
          "title": "Binding Kind",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "status": {
          "enum": [
            "matched",
            "ambiguous",
            "unmatched",
            "planned"
          ],
          "title": "Status",
          "type": "string"
        },
        "candidate_api_surface_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Api Surface Ids",
          "type": "array"
        },
        "selected_api_surface_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Api Surface Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "implementation_mapping_id",
        "target",
        "binding_kind",
        "language",
        "status"
      ],
      "title": "BundleCrosswalk",
      "type": "object"
    },
    "BundleDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "transitions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleTransition"
          },
          "title": "Transitions",
          "type": "array"
        },
        "mappings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleMapping"
          },
          "title": "Mappings",
          "type": "array"
        },
        "api_surfaces": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleSurface"
          },
          "title": "Api Surfaces",
          "type": "array"
        },
        "api_crosswalks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleCrosswalk"
          },
          "title": "Api Crosswalks",
          "type": "array"
        },
        "requirement_api_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleRequirementApiBinding"
          },
          "title": "Requirement Api Bindings",
          "type": "array"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "BundleDocument",
      "type": "object"
    },
    "BundleMapping": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interface_kind": {
          "minLength": 1,
          "title": "Interface Kind",
          "type": "string"
        },
        "interface_name": {
          "minLength": 1,
          "title": "Interface Name",
          "type": "string"
        },
        "requirement_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "transition_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Transition Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "interface_kind",
        "interface_name"
      ],
      "title": "BundleMapping",
      "type": "object"
    },
    "BundleParameter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "direction": {
          "default": "in",
          "enum": [
            "in",
            "out",
            "inout",
            "return"
          ],
          "title": "Direction",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "title": "BundleParameter",
      "type": "object"
    },
    "BundleRequirement": {
      "additionalProperties": false,
      "description": "One ordered, source-addressable requirement in a portable document.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "clause_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause Id"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "default": "",
          "title": "Statement",
          "type": "string"
        },
        "machine_statement": {
          "default": "",
          "title": "Machine Statement",
          "type": "string"
        },
        "kind": {
          "default": "detailed",
          "enum": [
            "summary",
            "detailed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "coverage_kind": {
          "default": "transition",
          "enum": [
            "transition",
            "cross-cutting",
            "document-wide",
            "not-applicable"
          ],
          "title": "Coverage Kind",
          "type": "string"
        },
        "coverage_note": {
          "default": "",
          "title": "Coverage Note",
          "type": "string"
        },
        "transition_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Transition Ids",
          "type": "array"
        },
        "api_surface_scope": {
          "default": "required",
          "enum": [
            "required",
            "cross-cutting",
            "not-applicable"
          ],
          "title": "Api Surface Scope",
          "type": "string"
        },
        "api_surface_note": {
          "default": "",
          "title": "Api Surface Note",
          "type": "string"
        },
        "api_surface_resolution": {
          "default": "strict",
          "enum": [
            "strict",
            "all-overloads"
          ],
          "title": "Api Surface Resolution",
          "type": "string"
        },
        "extraction": {
          "default": "explicit",
          "enum": [
            "explicit",
            "candidate"
          ],
          "title": "Extraction",
          "type": "string"
        },
        "semantic_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Group Id"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "title": "BundleRequirement",
      "type": "object"
    },
    "BundleRequirementApiBinding": {
      "additionalProperties": false,
      "description": "Portable requirement-to-language-API traceability record.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "api_surface_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Surface Id"
        },
        "candidate_api_surface_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Api Surface Ids",
          "type": "array"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "direct",
            "transition-backed",
            "callback",
            "not-applicable",
            "cross-cutting"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "reviewed",
            "matched",
            "ambiguous",
            "unmatched"
          ],
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/BundleSource"
        }
      },
      "required": [
        "id",
        "requirement_id",
        "language",
        "relationship",
        "status",
        "rationale",
        "source"
      ],
      "title": "BundleRequirementApiBinding",
      "type": "object"
    },
    "BundleSource": {
      "additionalProperties": false,
      "description": "Portable source location for a semantic or declaration record.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "BundleSource",
      "type": "object"
    },
    "BundleSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "binding_kind": {
          "enum": [
            "semantic",
            "native",
            "protocol",
            "language-adapter",
            "transport"
          ],
          "title": "Binding Kind",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "signature": {
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleParameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "result_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Type"
        },
        "exception_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exception Types",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "binding_kind",
        "owner",
        "language",
        "signature"
      ],
      "title": "BundleSurface",
      "type": "object"
    },
    "BundleTransition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "machine_id": {
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "event": {
          "default": "",
          "title": "Event",
          "type": "string"
        },
        "source_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source State"
        },
        "target_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target State"
        },
        "requirement_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "machine_id"
      ],
      "title": "BundleTransition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Portable semantic slice consumed by an external implementation repo.",
  "properties": {
    "schema_version": {
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "bundle_id": {
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "corpus_revision": {
      "minLength": 1,
      "title": "Corpus Revision",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/BundleDocument"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "corpus_revision",
    "documents"
  ],
  "title": "CorpusBundle",
  "type": "object",
  "": "https://document-recreation.local/schemas/corpus_bundle.schema.json"
}
