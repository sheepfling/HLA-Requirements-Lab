\ProvidesPackage{rl_graphics}[2026/08/23 Requirements Lab HLA family graphics]
% Requirements Lab abstract HLA family graphics -- shared TikZ definitions.
% Vector-only; no external images.

\usepackage{fontspec}
\usepackage{xcolor}
\usepackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,backgrounds,shapes.geometric}
\usepackage{etoolbox}
\usepackage{microtype}

\setsansfont{Inter}
\setmainfont{Noto Serif}

\definecolor{RLInk}{HTML}{172334}
\definecolor{RLMuted}{HTML}{687386}
\definecolor{RLRule}{HTML}{D6DEE8}
\definecolor{RLPaper}{HTML}{F8FAFC}
\definecolor{RLWhite}{HTML}{FFFFFF}
\definecolor{RLFramework}{HTML}{496B91}
\definecolor{RLFrameworkTint}{HTML}{EAF0F6}
\definecolor{RLInterface}{HTML}{6D5FA6}
\definecolor{RLInterfaceTint}{HTML}{EEEAF7}
\definecolor{RLOMT}{HTML}{CF7B31}
\definecolor{RLOMTTint}{HTML}{F7EEE4}
\definecolor{RL2010}{HTML}{637489}
\definecolor{RL2010Tint}{HTML}{EBEFF4}
\definecolor{RL2025}{HTML}{E7773F}
\definecolor{RL2025Tint}{HTML}{F7E8DF}

\newcommand{\RLSetVolume}[1]{%
  \def\RLVolume{#1}%
  \ifstrequal{#1}{framework}{%
    \colorlet{RLAccent}{RLFramework}%
    \colorlet{RLAccentTint}{RLFrameworkTint}%
    \def\RLStandard{IEEE 1516}%
    \def\RLShortTitle{Framework \& Rules}%
    \def\RLTitle{HLA Framework\\and Rules}%
    \def\RLDescriptor{Architecture, principles, and governing rules}%
  }{}%
  \ifstrequal{#1}{interface}{%
    \colorlet{RLAccent}{RLInterface}%
    \colorlet{RLAccentTint}{RLInterfaceTint}%
    \def\RLStandard{IEEE 1516.1}%
    \def\RLShortTitle{Federate Interface}%
    \def\RLTitle{HLA Federate Interface\\Specification}%
    \def\RLDescriptor{Runtime services across the federate--RTI boundary}%
  }{}%
  \ifstrequal{#1}{omt}{%
    \colorlet{RLAccent}{RLOMT}%
    \colorlet{RLAccentTint}{RLOMTTint}%
    \def\RLStandard{IEEE 1516.2}%
    \def\RLShortTitle{Object Model Template}%
    \def\RLTitle{HLA Object Model\\Template (OMT)\\Specification}%
    \def\RLDescriptor{Structure and semantics of exchanged information}%
  }{}%
}

\newcommand{\RLSetEdition}[1]{%
  \def\RLEdition{#1}%
  \ifnum#1=2010\relax
    \colorlet{RLEditionColor}{RL2010}%
    \colorlet{RLEditionTint}{RL2010Tint}%
    \def\RLEditionPhrase{established baseline}%
  \else
    \colorlet{RLEditionColor}{RL2025}%
    \colorlet{RLEditionTint}{RL2025Tint}%
    \def\RLEditionPhrase{layered extension}%
  \fi
}

\tikzset{
  rl line/.style={draw=RLAccent,line width=1.15pt,line cap=round,line join=round},
  rl fine/.style={draw=RLAccent!55,line width=0.62pt,line cap=round,line join=round},
  rl faint/.style={draw=RLAccent!25,line width=0.48pt,line cap=round,line join=round},
  rl node/.style={circle,fill=RLAccent,draw=RLWhite,line width=0.7pt,minimum size=4.1pt,inner sep=0pt},
  rl node open/.style={circle,fill=RLWhite,draw=RLAccent,line width=0.85pt,minimum size=4.1pt,inner sep=0pt},
  rl arrow/.style={draw=RLAccent,line width=1.0pt,-{Stealth[length=4.2pt,width=3.6pt]},line cap=round},
  rl arrow muted/.style={draw=RLAccent!55,line width=0.78pt,-{Stealth[length=3.7pt,width=3.1pt]},line cap=round},
}

% Edition frame: 2010 is contained on one plane; 2025 is layered and extends.
\newcommand{\RLEditionFrame}[1]{%
  \ifnum#1=2010\relax
    \draw[draw=RLAccent!45,line width=0.82pt] (-1.55,-1.55) rectangle (1.55,1.55);
    \draw[draw=RLAccent!16,line width=0.55pt] (-1.35,-1.35) rectangle (1.35,1.35);
  \else
    \draw[draw=RLAccent!34,line width=0.74pt] (-1.55,-1.38) rectangle (1.34,1.50);
    \draw[draw=RLAccent!18,line width=0.58pt] (-1.18,-1.60) rectangle (1.60,1.18);
    \draw[draw=RLEditionColor,line width=1.05pt] (1.34,0.54) -- (1.34,1.50) -- (0.42,1.50);
  \fi
}

% Framework / rules: whole-system topology constrained by a common frame.
\newcommand{\RLOverviewGlyph}[1]{%
  \RLEditionFrame{#1}%
  \ifnum#1=2010\relax
    \draw[rl fine] (0,0) circle (1.02);
    \draw[rl faint] (0,0) circle (0.58);
    \coordinate (n1) at (90:1.02);
    \coordinate (n2) at (0:1.02);
    \coordinate (n3) at (270:1.02);
    \coordinate (n4) at (180:1.02);
    \foreach \n in {n1,n2,n3,n4}{\draw[rl fine] (0,0) -- (\n);}
    \draw[rl line] (n1)--(n2)--(n3)--(n4)--cycle;
    \node[rl node] at (0,0) {};
    \foreach \n in {n1,n2,n3,n4}{\node[rl node open] at (\n) {};}
  \else
    \draw[rl fine] (0,0) circle (0.84);
    \draw[rl faint] (0.12,-0.06) circle (1.18);
    \coordinate (n1) at (104:1.18);
    \coordinate (n2) at (38:1.18);
    \coordinate (n3) at (-28:1.18);
    \coordinate (n4) at (-104:1.18);
    \coordinate (n5) at (176:1.18);
    \coordinate (n6) at (1.72,0.48);
    \draw[rl fine] (n1)--(n2)--(n3)--(n4)--(n5)--cycle;
    \draw[rl line] (n1)--(0.08,0.10)--(n3);
    \draw[rl line] (n5)--(0.08,0.10)--(n2);
    \draw[rl fine] (n4)--(0.08,0.10);
    \draw[draw=RLEditionColor,line width=1.22pt,line cap=round] (0.08,0.10)--(n6);
    \node[rl node] at (0.08,0.10) {};
    \foreach \n in {n1,n2,n3,n4,n5}{\node[rl node open] at (\n) {};}
    \node[circle,fill=RLEditionColor,draw=RLWhite,line width=0.7pt,minimum size=4.5pt,inner sep=0pt] at (n6) {};
  \fi
}

% Interface: two participants exchanging service and callback flows across a boundary.
\newcommand{\RLInterfaceGlyph}[1]{%
  \RLEditionFrame{#1}%
  \ifnum#1=2010\relax
    \draw[rl line,rounded corners=2pt] (-1.27,-0.56) rectangle (-0.62,0.56);
    \draw[rl line,rounded corners=2pt] (0.62,-0.56) rectangle (1.27,0.56);
    \draw[rl fine] (-0.12,-0.82) rectangle (0.12,0.82);
    \foreach \y in {-0.26,0,0.26}{%
      \node[rl node open] at (-0.62,\y) {};
      \node[rl node open] at (0.62,\y) {};
    }
    \draw[rl arrow] (-0.52,0.22) -- (0.50,0.22);
    \draw[rl arrow] (0.52,-0.22) -- (-0.50,-0.22);
  \else
    \draw[rl fine,rounded corners=2pt] (-1.37,-0.72) rectangle (-0.62,0.48);
    \draw[rl line,rounded corners=2pt] (-1.22,-0.49) rectangle (-0.47,0.71);
    \draw[rl fine,rounded corners=2pt] (0.62,-0.48) rectangle (1.37,0.72);
    \draw[rl line,rounded corners=2pt] (0.47,-0.71) rectangle (1.22,0.49);
    \draw[rl fine] (-0.18,-0.90) -- (-0.18,0.90);
    \draw[rl fine] (0.18,-0.90) -- (0.18,0.90);
    \draw[rl arrow] (-0.40,0.42) -- (0.40,0.42);
    \draw[rl arrow muted] (0.40,0.00) -- (-0.40,0.00);
    \draw[rl arrow] (-0.40,-0.42) -- (0.40,-0.42);
    \draw[draw=RLEditionColor,line width=1.05pt,-{Stealth[length=4.0pt,width=3.4pt]},line cap=round]
      (0.86,0.82) .. controls (0.20,1.22) and (-0.34,1.16) .. (-0.88,0.77);
    \node[diamond,fill=RLWhite,draw=RLAccent,line width=0.9pt,minimum size=8.5pt,inner sep=0pt] at (0,0) {};
  \fi
}

% Helper for a wireframe cube centered near the origin.
\newcommand{\RLCube}[4]{%
  % x shift, y shift, size, opacity-ish mix percentage
  \begin{scope}[shift={(#1,#2)},scale=#3]
    \coordinate (a) at (-0.72,-0.62);
    \coordinate (b) at (0.72,-0.62);
    \coordinate (c) at (0.72,0.82);
    \coordinate (d) at (-0.72,0.82);
    \coordinate (ap) at (-0.20,-0.28);
    \coordinate (bp) at (1.24,-0.28);
    \coordinate (cp) at (1.24,1.16);
    \coordinate (dp) at (-0.20,1.16);
    \draw[draw=RLAccent!#4,line width=0.78pt,line join=round] (a)--(b)--(c)--(d)--cycle;
    \draw[draw=RLAccent!#4,line width=0.78pt,line join=round] (ap)--(bp)--(cp)--(dp)--cycle;
    \foreach \p/\q in {a/ap,b/bp,c/cp,d/dp}{\draw[draw=RLAccent!#4,line width=0.78pt] (\p)--(\q);}
  \end{scope}
}

% OMT: structured model/lattice; 2025 adds an extendable module and cross-layer link.
\newcommand{\RLOMTGlyph}[1]{%
  \RLEditionFrame{#1}%
  \ifnum#1=2010\relax
    \RLCube{-0.22}{-0.18}{0.92}{70}
    \draw[rl fine] (-0.88,-0.20)--(-0.16,0.52)--(0.72,-0.12);
    \node[rl node] at (-0.88,-0.20) {};
    \node[rl node open] at (-0.16,0.52) {};
    \node[rl node] at (0.72,-0.12) {};
    \draw[rl faint] (-0.16,0.52)--(0.66,0.95);
    \node[rl node open] at (0.66,0.95) {};
  \else
    \RLCube{-0.48}{-0.37}{0.80}{55}
    \RLCube{0.08}{-0.04}{0.64}{28}
    \draw[rl line] (-0.98,-0.34)--(-0.30,0.38)--(0.54,-0.16)--(0.90,0.58);
    \draw[rl fine] (-0.30,0.38)--(0.20,0.92);
    \draw[draw=RLEditionColor,line width=1.15pt,line cap=round] (0.90,0.58)--(1.52,0.88);
    \node[rl node] at (-0.98,-0.34) {};
    \node[rl node open] at (-0.30,0.38) {};
    \node[rl node] at (0.54,-0.16) {};
    \node[rl node open] at (0.90,0.58) {};
    \node[rl node open] at (0.20,0.92) {};
    \node[rectangle,fill=RLEditionColor,draw=RLWhite,line width=0.7pt,minimum size=5.2pt,inner sep=0pt] at (1.52,0.88) {};
  \fi
}

\newcommand{\RLGlyph}[2]{%
  \RLSetVolume{#2}%
  \RLSetEdition{#1}%
  \ifstrequal{#2}{framework}{\RLOverviewGlyph{#1}}{}%
  \ifstrequal{#2}{interface}{\RLInterfaceGlyph{#1}}{}%
  \ifstrequal{#2}{omt}{\RLOMTGlyph{#1}}{}%
}

% Compact card for the contact sheet.
\newcommand{\RLCard}[4]{%
  % x, y, edition, volume. Assumes x=y=1in coordinate system.
  \RLSetVolume{#4}%
  \RLSetEdition{#3}%
  \begin{scope}[shift={(#1,#2)}]
    \path[fill=RLWhite,draw=RLRule,line width=0.75pt,rounded corners=4pt] (0,0) rectangle (3.23,3.42);
    \fill[RLAccentTint] (0,2.60) -- (2.02,3.42) -- (3.23,3.42) -- (3.23,1.80) -- cycle;
    \fill[RLEditionTint,opacity=0.88] (1.77,3.42) -- (3.23,3.42) -- (3.23,2.28) -- (2.46,1.92) -- cycle;
    \fill[RLAccent] (0,0) rectangle (0.055,3.42);

    \node[anchor=north west,font=\sffamily\bfseries\fontsize{6.2}{7.2}\selectfont,text=RLInk] at (0.22,3.18) {HLA REQUIREMENTS LAB};
    \draw[draw=RLAccent,line width=1.1pt] (0.22,2.98)--(0.78,2.98);
    \node[anchor=north east,align=center,text width=0.55in,font=\sffamily\bfseries\fontsize{8.5}{9.2}\selectfont,text=RLEditionColor] at (3.00,3.19) {#3};
    \node[anchor=north east,font=\sffamily\fontsize{4.4}{5.2}\selectfont,text=RLMuted] at (3.00,2.83) {EDITION};

    \node[anchor=north west,align=left,text width=1.82in,font=\sffamily\bfseries\fontsize{10.8}{12.3}\selectfont,text=RLInk] at (0.25,1.62) {\RLShortTitle};
    \node[anchor=west,font=\sffamily\fontsize{6.9}{8.2}\selectfont,text=RLMuted] at (0.25,1.08) {\RLStandard\ - #3};
    \node[anchor=north west,align=left,text width=1.78in,font=\rmfamily\itshape\fontsize{6.2}{7.7}\selectfont,text=RLInk] at (0.25,0.86) {\RLDescriptor};

    \begin{scope}[shift={(2.48,2.16)},scale=0.40]
      \RLGlyph{#3}{#4}
    \end{scope}

    \node[anchor=south west,font=\sffamily\fontsize{4.6}{5.4}\selectfont,text=RLMuted] at (0.24,0.16) {\MakeUppercase{\RLEditionPhrase}};
    \node[anchor=south east,font=\sffamily\bfseries\fontsize{4.8}{5.6}\selectfont,text=RLAccent] at (3.00,0.16) {\MakeUppercase{\RLShortTitle}};
  \end{scope}
}

% Full letter-size cover study. Draw in a tikzpicture with x=y=1in.
\newcommand{\RLCover}[2]{%
  \RLSetVolume{#2}%
  \RLSetEdition{#1}%
  \begin{tikzpicture}[remember picture,overlay,x=1in,y=1in]
    \begin{scope}[shift={(current page.south west)}]
    \fill[RLWhite] (0,0) rectangle (8.5,11);

    % Shared family geometry; edition changes the construction rather than adding imagery.
    \ifnum#1=2010\relax
      \fill[RLAccentTint] (0,10.20)--(3.72,10.20)--(6.18,5.24)--(4.32,2.18)--(0,2.18)--cycle;
      \fill[RLEditionTint,opacity=0.83] (4.70,11)--(8.50,11)--(8.50,6.48)--(6.58,5.45)--(4.18,9.10)--cycle;
      \draw[draw=RLAccent!30,line width=0.8pt] (4.96,5.39) rectangle (8.05,8.50);
    \else
      \fill[RLAccentTint] (0,10.20)--(3.58,10.20)--(6.25,5.04)--(4.60,2.18)--(0,2.18)--cycle;
      \fill[RLEditionTint,opacity=0.90] (4.55,11)--(8.50,11)--(8.50,3.24)--(6.72,2.20)--(4.10,8.75)--cycle;
      \fill[RLEditionTint,opacity=0.45] (5.36,9.34) circle (2.12);
      \fill[RLAccent!12,opacity=0.72] (4.84,5.12) rectangle (8.08,8.62);
      \draw[draw=RLEditionColor!48,line width=0.9pt] (6.58,1.96)--(8.07,3.43);
    \fi

    % Header and legal status.
    \node[anchor=north west,font=\sffamily\bfseries\fontsize{8.7}{10.2}\selectfont,text=RLInk] at (0.97,10.20) {HLA REQUIREMENTS LAB};
    \draw[draw=RLAccent,line width=2.0pt] (0.97,9.73)--(2.73,9.73);
    \node[anchor=north west,font=\sffamily\fontsize{6.9}{8.2}\selectfont,text=RLAccent] at (0.97,9.43) {UNOFFICIAL - NON-AUTHORITATIVE DERIVED EDITION};

    % Edition tag.
    \path[fill=RLEditionTint,draw=RLEditionColor!55,line width=0.65pt] (7.00,9.82) rectangle (8.22,10.73);
    \node[anchor=north,font=\sffamily\bfseries\fontsize{17.8}{19}\selectfont,text=RLEditionColor] at (7.61,10.55) {#1};
    \node[anchor=north,font=\sffamily\fontsize{6.0}{7.0}\selectfont,text=RLMuted] at (7.61,10.08) {EDITION};

    % Document identity.
    \node[anchor=north west,align=left,text width=4.25in,font=\sffamily\bfseries\fontsize{24}{27}\selectfont,text=RLInk] at (0.98,7.73) {\RLTitle};
    \node[anchor=north west,font=\sffamily\fontsize{9.8}{11.8}\selectfont,text=RLInk] at (0.98,6.01) {\RLStandard\ - #1 edition};
    \node[anchor=north west,text width=4.45in,font=\rmfamily\itshape\fontsize{10.2}{12.7}\selectfont,text=RLInk] at (0.98,5.57) {\RLDescriptor};

    % Graphic.
    \begin{scope}[shift={(6.46,7.13)},scale=0.97]
      \RLGlyph{#1}{#2}
    \end{scope}

    % Source/provenance box.
    \path[fill=RLPaper,draw=RLAccent!36,line width=0.72pt] (0.97,0.96) rectangle (6.62,3.12);
    \fill[RLAccent] (0.97,0.96) rectangle (1.08,3.12);
    \node[anchor=north west,font=\sffamily\bfseries\fontsize{8.8}{10.4}\selectfont,text=RLInk] at (1.34,2.78) {Source-traceable HLA requirements and technical contracts};
    \node[anchor=north west,align=left,text width=4.95in,font=\sffamily\fontsize{6.65}{8.7}\selectfont,text=RLInk] at (1.34,2.43) {Requirements Lab original work: cover, editorial compilation, semantic model, and quality gates.\\Source reference: prepared from supplied IEEE material. No IEEE publication, ownership, approval, or endorsement is implied.};
    \node[anchor=north west,font=\sffamily\bfseries\fontsize{6.8}{8.2}\selectfont,text=RLInk] at (1.34,1.48) {Lab-authored derived document; source reference only.};

    % Footer.
    \draw[draw=RLRule,line width=0.7pt] (0.97,0.73)--(8.22,0.73);
    \node[anchor=south west,font=\sffamily\fontsize{6.2}{7.2}\selectfont,text=RLInk] at (0.97,0.29) {HLA 1516 FAMILY  |  #1 edition  |  DERIVED WORKING EDITION};
    \node[anchor=south east,font=\sffamily\bfseries\fontsize{6.4}{7.4}\selectfont,text=RLAccent] at (8.22,0.29) {REQUIREMENTS LAB};
    \end{scope}
  \end{tikzpicture}%
}
