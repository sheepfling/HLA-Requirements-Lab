\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{rl-headings.sty}[2026/08/23 v0.1 Requirements Lab hierarchy]

\RequirePackage{titlesec}

\titleformat{\section}[display]
    {\RLSans\bfseries\color{RLBlueDeep}}
    {\fontsize{25pt}{27pt}\selectfont\thesection}
    {8pt}
    {\fontsize{17pt}{20pt}\selectfont}
\titlespacing*{\section}{0pt}{24pt}{18pt}

\titleformat{\subsection}
    {\RLSans\bfseries\color{RLBlueDeep}}
    {\fontsize{13pt}{15pt}\selectfont\thesubsection}
    {0.65em}
    {\fontsize{13pt}{15pt}\selectfont}
\titlespacing*{\subsection}{0pt}{17pt}{7pt}

\titleformat{\subsubsection}
    {\RLSans\bfseries\color{RLInk}}
    {\fontsize{10.5pt}{12pt}\selectfont\thesubsubsection}
    {0.65em}
    {\fontsize{10.5pt}{12pt}\selectfont}
\titlespacing*{\subsubsection}{0pt}{12pt}{4pt}

\titleformat{\paragraph}[runin]
    {\RLSans\bfseries\color{RLInk}}
    {}{0pt}{}
\titlespacing*{\paragraph}{0pt}{8pt}{0.7em}

\newcommand{\RLClauseOpener}[3]{%
    \clearpage
    \thispagestyle{empty}
    \vspace*{0.55in}
    {\RLSans\fontsize{34pt}{37pt}\selectfont\bfseries\color{RLBlueDeep}#1\par}
    \vspace{12pt}
    {\RLSans\fontsize{21pt}{25pt}\selectfont\bfseries\color{RLInk}#2\par}
    \vspace{16pt}
    \RLAccentRule
    \vspace{16pt}
    {\RLSerif\fontsize{11pt}{15pt}\selectfont\color{RLMid}#3\par}
    \vfill
    \RLRule
    \vspace{7pt}
    {\RLSans\fontsize{7.5pt}{9pt}\selectfont\color{RLMid}\RLPublicationShort\enspace\textbar\enspace\RLPublicationEdition\hfill CLAUSE OPENER\par}
    \clearpage
}

\newcommand{\RLHeading}[2]{%
    \par\vspace{0.75em}%
    {\RLSans\bfseries\color{RLBlueDeep}\fontsize{#1}{\dimexpr#1pt+2pt\relax}\selectfont #2\par}%
    \vspace{0.25em}%
}

% Prototype-compatible compact labels for ordinary subclauses. Major clause
% openers may still use RLHeading; source-like subclauses should remain quiet
% enough that tables and prose retain the visual priority.
\newcommand{\RLSubclauseLabel}[1]{%
    \par\vspace{3pt}\noindent
    {\RLSans\mdseries\fontsize{7.4pt}{9pt}\selectfont
    \addfontfeatures{LetterSpace=5.0}\color{RLBlue}\MakeUppercase{#1}\par}%
    \vspace{4pt}%
}

\newcommand{\RLMinorHeading}[1]{%
    \par\vspace{4pt}\noindent
    {\RLSans\bfseries\fontsize{11.5pt}{14pt}\selectfont\color{RLInk}#1\par}%
    \vspace{3pt}%
}

\newcommand{\RLMinorHeadingSmall}[1]{%
    \par\vspace{3pt}\noindent
    {\RLSans\bfseries\fontsize{10.2pt}{12.4pt}\selectfont\color{RLInk}#1\par}%
    \vspace{3pt}%
}

\newcommand{\RLMajorInFlow}[1]{%
    \par\vspace{2pt}\noindent
    {\color{RLLine}\rule{\linewidth}{0.6pt}}\par\vspace{6pt}%
    {\RLSans\bfseries\fontsize{13.5pt}{16pt}\selectfont\color{RLInk}#1\par}%
    \vspace{3pt}%
}
