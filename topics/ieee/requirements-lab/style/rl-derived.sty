\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{rl-derived.sty}[2026/08/25 v0.1 Requirements Lab derivative typography]

% Derivative publications are reflowable semantic products rather than
% source-page reconstructions.  Give them the same reading faces and heading
% grammar as the approved OMT interior without changing the measured geometry
% of the faithful source compilations.
\input{../requirements-lab/style/rl-headings.sty}
\input{../requirements-lab/style/rl-tables.sty}
\RequirePackage{needspace}
\RequirePackage{multicol}

\newcounter{hlabsembookmark}
\newcommand{\HLASemanticBookmark}[2]{%
    \stepcounter{hlabsembookmark}%
    \pdfbookmark[#1]{#2}{hlab-semantic-\arabic{hlabsembookmark}}%
}

\newcommand{\RLConfigureDerivativeTypography}{%
    \AtBeginDocument{%
        \RLBodyFont
        \RaggedRight
    }%
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{6pt plus 1pt minus 1pt}%
    \setlength{\emergencystretch}{3em}%
}
