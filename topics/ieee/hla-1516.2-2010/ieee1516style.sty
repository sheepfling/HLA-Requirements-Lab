}
\newcommand{\firststandardpage}{\thispagestyle{firststandard}}

\newenvironment{definition}[1]{%
    \par\noindent\textbf{#1:}\ \ignorespaces
}{\par}

\newcommand{\stdnote}[1]{%
    \par\vspace{-1pt}\noindent{\smallbodyfont NOTE---#1}\par
}
\newcommand{\stdnoteinline}[1]{%
        {\smallbodyfont NOTE---#1}%
}

\newenvironment{sourcequote}{\begin{quote}\smallbodyfont}{\end{quote}}

\newcommand{\sourcepage}[1]{\marginpar{\tiny\textsf{PDF p.~#1}}}

\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{C}[1]{>{\Centering\arraybackslash}p{#1}}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}

\newcommand{\ieeeattribution}{Source set: supplied HLA 1516.2 family materials from 2010.}

% OMT table reconstruction helpers.  These are deliberately compact: the
% source standard uses dense, fully ruled tables with small type.
\definecolor{HLAOMTBlue}{HTML}{496B91}
\definecolor{HLAOMTOrange}{HTML}{E7773F}
\newcommand{\omttablefont}{\fontsize{9}{10.9}\selectfont}
\newcommand{\omttablesmallfont}{\fontsize{9}{10.9}\selectfont}
\newcommand{\omtcaption}[1]{%
    \par\vspace{0pt}\begin{center}%
    {\sffamily\bfseries\fontsize{10.8}{12}\selectfont #1}\par
    \end{center}\vspace{-2pt}%
}
\newcommand{\omtcontinuedcaption}[1]{%
    \par\vspace{0pt}\begin{center}%
    {\sffamily\bfseries\fontsize{10.8}{12}\selectfont #1 \textit{(continued)}}\par
    \end{center}\vspace{-2pt}%
}
\newcommand{\omtph}[1]{\textless#1\textgreater}
\newcommand{\omtopt}[1]{[\textless#1\textgreater]}
\newcommand{\omtsubfield}[1]{\hspace*{1.25em}\textit{#1}}
\newcommand{\omtdash}{---\hspace{0.35em}}
% The Glyph category is represented by a small abstract object-model mark.
% It is intentionally vector-only so it remains crisp and portable in the
% Lab compilation.
\newcommand{\omtcategoryglyph}{%
    \raisebox{-0.35ex}{%
        \begin{tikzpicture}[x=1pt,y=1pt,baseline=(current bounding box.center)]
        \draw[HLAOMTBlue,line width=.75pt] (1.5,1.5) rectangle (20.5,20.5);
        \draw[HLAOMTBlue,line width=.7pt] (4,14.5) -- (9.5,7) -- (15,11.5) -- (19,5);
        \draw[HLAOMTBlue,line width=.55pt] (9.5,7) -- (9.5,18.5) (15,11.5) -- (15,18.5);
        \fill[HLAOMTOrange] (4,14.5) circle (1.45);
        \fill[HLAOMTOrange] (9.5,7) circle (1.45);
        \fill[HLAOMTBlue] (15,11.5) circle (1.45);
        \fill[HLAOMTBlue] (19,5) circle (1.45);
        \end{tikzpicture}%
    }%
}

