\RequirePackage{multicol}
\RequirePackage{titlesec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{multirow}

\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Noto Serif}
\setsansfont{Inter}[
    Path=../requirements-lab/fonts/,
    UprightFont=Inter-Regular.ttf,
    ItalicFont=Inter-Italic.ttf,
    BoldFont=Inter-ExtraBold.ttf,
    BoldItalicFont=Inter-Italic.ttf,
    Ligatures=NoCommon]

\setlength{\parindent}{0pt}
\setlength{\parskip}{8.0pt plus 1.0pt minus 0.8pt}
\setlength{\emergencystretch}{3em}
\linespread{0.965}
\setlist[itemize]{leftmargin=1.75em,label=---,itemsep=2.2pt,topsep=2.5pt,parsep=0pt}
\setlist[enumerate]{leftmargin=1.75em,itemsep=2.2pt,topsep=2.5pt,parsep=0pt}

% These labels identify the independent Lab compilation. IEEE identifiers remain
% in the technical body only where they identify supplied source references.
\newcommand{\stdnumber}{HLA 1516.2 \textperiodcentered\ 2010 source compilation}
\newcommand{\stdtitleupper}{OBJECT MODEL TEMPLATE (OMT) SPECIFICATION}
\newcommand{\stdshortupper}{HLA REQUIREMENTS LAB}
\newcommand{\stdcopyright}{}

\newcommand{\bodyfont}{\fontsize{10.0}{12.0}\selectfont}
\newcommand{\smallbodyfont}{\fontsize{8.15}{9.65}\selectfont}
\newcommand{\tinybodyfont}{\fontsize{7.25}{8.55}\selectfont}

\titleformat{\section}[hang]
{\sffamily\bfseries\fontsize{13.5}{16}\selectfont}
{\thesection.}{0.42em}{}
\titlespacing*{\section}{0pt}{10pt}{5pt}

\titleformat{\subsection}[hang]
{\sffamily\bfseries\fontsize{12.0}{13.2}\selectfont}
{\thesubsection}{0.48em}{}
\titlespacing*{\subsection}{0pt}{0pt}{3.5pt}

\titleformat{\subsubsection}[hang]
{\sffamily\bfseries\fontsize{10.85}{12.4}\selectfont}
{\thesubsubsection}{0.48em}{}
\titlespacing*{\subsubsection}{0pt}{0pt}{1pt}

\newcommand{\standardbodylayout}{%
    \newgeometry{top=0.94in,bottom=0.87in,left=1.25in,right=1.25in,headheight=14pt,headsep=0.344in,footskip=0.43in}%
    \setlength{\headwidth}{\textwidth}%
    \linespread{1.0}\selectfont%
    \setlength{\parskip}{12pt plus 1pt minus 1pt}%
    \setlist[itemize]{leftmargin=32pt,labelwidth=10pt,labelsep=12pt,label=---,itemsep=2pt,topsep=3pt,parsep=0pt}%
    \setlist[enumerate]{leftmargin=32pt,labelwidth=10pt,labelsep=12pt,itemsep=2pt,topsep=3pt,parsep=0pt}%
    \bodyfont%
}

\newcommand{\standardheaders}{%
    \pagestyle{fancy}%
    \fancyhf{}%
    \fancyhead[LE]{\sffamily\fontsize{8.67}{9.2}\selectfont \stdnumber}%
    \fancyhead[RE]{\sffamily\fontsize{8.67}{9.2}\selectfont \stdshortupper}%
    \fancyhead[LO]{\sffamily\fontsize{8.67}{9.2}\selectfont \stdtitleupper}%
    \fancyhead[RO]{\sffamily\fontsize{8.67}{9.2}\selectfont \stdnumber}%
    \fancyfoot[LE,RO]{\fontsize{10}{11}\selectfont\thepage}%
    \fancyfoot[LO,RE]{\sffamily\fontsize{8.67}{9.2}\selectfont\stdcopyright}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
}

\newcommand{\frontheaders}{%
    \pagestyle{fancy}%
    \fancyhf{}%
    \fancyfoot[LE,RO]{\fontsize{10}{11}\selectfont\thepage}%
    \fancyfoot[LO,RE]{\sffamily\fontsize{8.67}{9.2}\selectfont\stdcopyright}%
