% The generated page adapters retain source coordinates, but their visual
% roles belong to the independent Requirements Lab publication system.
% Loading the shared role files here keeps the adapters thin and gives every
% inherited block the same checked-in fonts and color tokens as the accepted
% production interior.
\input{../requirements-lab/style/rl-brand.sty}
\input{../requirements-lab/style/rl-type.sty}
\input{../requirements-lab/style/rl-publication.sty}

\let\HLAArial\RLSans
\let\HLATimes\RLSerif
\let\HLACalibri\RLSans
\let\HLAMontserrat\RLSans
\let\HLASymbol\RLSans
\let\HLAFallback\RLSerif

\newcommand{\HLAFontArial}{\HLAArial}
\newcommand{\HLAFontTimes}{\HLATimes}
\newcommand{\HLAFontCalibri}{\HLACalibri}
\newcommand{\HLAFontMontserrat}{\HLAMontserrat}
\newcommand{\HLAFontSymbol}{\HLASymbol}
\newcommand{\HLAFontFallback}{\HLAFallback}

% Coordinate-backed fidelity-oracle compatibility.
\newcommand{\HLABeginPage}{%
    \thispagestyle{empty}%
    \null%
    \begin{tikzpicture}[
        remember picture,
        overlay,
        shift={(current page.north west)},
        x=1bp,
        y=-1bp
    ]%
}

\newcommand{\HLAEndPage}{%
    \end{tikzpicture}%
    \newpage%
}

\newcommand{\HLAUnofficialNotice}{%
    % Retained as an empty compatibility hook for retired source-page
    % adapters. Independent Lab documents do not need a publisher disclaimer.
}

% Stable identifiers remain explicit in semantic source and manifests. PDF
% destinations are disabled by default because thousands of targets inside
% fixed-position TikZ blocks make XeLaTeX builds disproportionately slow.
% Enable them for a dedicated anchor-bearing release build when needed.
\newif\ifHLAStableAnchors
\HLAStableAnchorsfalse
\newcommand{\HLAEnableStableAnchors}{\HLAStableAnchorstrue}
\newcommand{\HLAStableID}[1]{%
    \ifHLAStableAnchors\hypertarget{#1}{}\fi
}

\newcommand{\HLABodyFont}{\HLATimes\fontsize{9.96bp}{12bp}\selectfont}
\newcommand{\HLASmallBodyFont}{\HLATimes\fontsize{9bp}{10.5bp}\selectfont}
\newcommand{\HLAFootnoteFont}{\HLATimes\fontsize{7.15bp}{8.3bp}\selectfont}
\newcommand{\HLAContentsFont}{\HLATimes\fontsize{9.96bp}{12bp}\selectfont}

% The source-coordinate edition historically used a separate resizebox for
% nearly every line of prose. That is useful for page-for-page comparison, but
% it also lets TeX scale adjacent lines by slightly different amounts. The Lab
% working edition can opt into stable paragraph typography while leaving
% headings, figures, and tables on their existing layout adapters.
\newif\ifHLALabModernTypography
\HLALabModernTypographyfalse
\newcommand{\HLAEnableModernTypography}{\HLALabModernTypographytrue}
\newcommand{\HLADisableModernTypography}{\HLALabModernTypographyfalse}
\newcommand{\HLAStableBlockText}[1]{%
    \begingroup
    \ifHLALabModernTypography
        \renewcommand{\resizebox}[3]{##3}%
    \fi
    #1%
    \endgroup
}
% Some fixed-page source lines use an explicit makebox whose width was
% measured with a different source font. Keep the authored width and left
% alignment, but scale only when the current role font would protrude.
\newcommand{\HLAConditionalMakeBox}[2]{%
    \begingroup
    \sbox0{#2}%
    \ifdim\wd0>#1bp
        \resizebox{#1bp}{!}{\usebox0}%
    \else
        \makebox[#1bp][l]{\usebox0}%
    \fi
    \endgroup
}
\newcommand{\HLAConditionalLine}[1]{%
    \begingroup
    \sbox0{#1}%
    \ifdim\wd0>\linewidth
        \resizebox{\linewidth}{!}{\usebox0}%
    \else
        \usebox0%
    \fi
    \endgroup
}
\newcommand{\HLASup}[1]{%
    \raisebox{0.72ex}{\HLATimes\fontsize{6bp}{6bp}\selectfont #1}%
}


% Script helpers that stay in the selected text font. The kernel
% \textsuperscript/\textsubscript commands can fall back to tiny Computer
% Modern math shapes after nested geometric scaling, which creates avoidable
% font-substitution warnings in the dense data-representation tables.
\NewDocumentCommand{\HLATextSup}{m}{%
    \raisebox{0.62ex}{\scalebox{0.67}{#1}}%
}
\NewDocumentCommand{\HLATextSub}{m}{%
    \raisebox{-0.24ex}{\scalebox{0.67}{#1}}%
}

\newcommand{\HLAStandardFooter}[1]{%
}

% The fixed-page body uses the same furniture as the accepted Requirements
% Lab interior. The shared module keeps text dark blue/ink and reserves
% orange for the short non-semantic marker.
\newcommand{\HLARequirementsLabFurniture}{\RLFixedFurniture}
\RLDefineFixedPageStyle{HLARL}

% Fixed-layout front matter occasionally contains independent semantic blocks
% whose visual order differs from the PDF content-stream order. This helper
% positions a whole block; individual words and lines remain ordinary TeX.
\NewDocumentCommand{\HLAFrontPlacedBlock}{m m m +m}{%
    \par\noindent
    \begin{tikzpicture}[
        remember picture,
        overlay,
        shift={(current page.north west)},
        x=1bp,
        y=-1bp
    ]
    \node[anchor=north west,inner sep=0bp,outer sep=0bp,text width=#3bp]
    at (#1,#2) {\begin{minipage}[t]{#3bp}
                    \setlength{\parindent}{0pt}#4
    \end{minipage}};
    \end{tikzpicture}%
    \par\vspace{-\baselineskip}%
}

\NewDocumentEnvironment{HLASemanticPage}{O{}}{%
    \thispagestyle{HLARL}%
    \IfBlankF{#1}{\HLAStandardFooter{#1}}%
    \HLABodyFont%
    \justifying%
    \setlength{\parindent}{0pt}%
    \hyphenpenalty=10000%
    \exhyphenpenalty=10000%
    \pretolerance=10000%
    \tolerance=10000%
    \hbadness=10000%
    \setlength{\emergencystretch}{1em}%
}{%
    \par\newpage%
}

\newcommand{\HLAFrontHeading}[1]{%
        {\begingroup\hyphenpenalty=10000\exhyphenpenalty=10000\HLAArial\fontsize{13.98bp}{16.08bp}\selectfont\bfseries #1\par\endgroup}%
    \vspace{12.3bp}%
}

\newcommand{\HLAFrontSubheading}[1]{%
    \vspace{3.7bp}%
    {\begingroup\hyphenpenalty=10000\exhyphenpenalty=10000\HLAArial\fontsize{10.98bp}{12.63bp}\selectfont\bfseries #1\par\endgroup}%
    \vspace{9.7bp}%
}

\newcommand{\HLAFrontMinorHeading}[1]{%
    \vspace{2.2bp}%
    {\begingroup\hyphenpenalty=10000\exhyphenpenalty=10000\HLAArial\fontsize{9.96bp}{11.45bp}\selectfont\bfseries #1\par\endgroup}%
    \vspace{7.5bp}%
}

\newcommand{\HLAPara}[1]{#1\par\vspace{11.7bp}}
\newcommand{\HLACompactPara}[1]{#1\par\vspace{7.4bp}}
\newcommand{\HLALink}[2]{\href{#1}{\textcolor{HLAc0000FF}{#2}}}

% M3 clause-body fixed-page semantic block support. Each positioned object is
% a complete logical block (heading, paragraph, definition, list, or footnote),
% never a word-level facsimile fragment.
\NewDocumentCommand{\HLAClausePlacedBlock}{m m m +m}{%
    \par\noindent
    \begin{tikzpicture}[
        remember picture,overlay,shift={(current page.north west)},x=1bp,y=-1bp
    ]
    \node[anchor=north west,inner sep=0bp,outer sep=0bp,text width=#3bp]
    at (#1,#2) {\begin{minipage}[t]{#3bp}
    \setlength{\parindent}{0pt}#4
    \end{minipage}};
    \end{tikzpicture}%
    \par\vspace{-\baselineskip}%
}

\NewDocumentCommand{\HLAClauseRule}{m m m m}{%
    \par\noindent
    \begin{tikzpicture}[
        remember picture,overlay,shift={(current page.north west)},x=1bp,y=-1bp
    ]
    \draw[line width=#4bp] (#1,#2) -- ++(#3,0);
    \end{tikzpicture}%
    \par\vspace{-\baselineskip}%
}

\newcommand{\HLAClauseHeading}[1]{{\color{RLBlueDeep}\HLAConditionalLine{\HLAArial\fontsize{13.98bp}{16.08bp}\selectfont\bfseries\mbox{#1}}\par}}
\newcommand{\HLASubclauseHeading}[1]{{\color{RLBlueDeep}\HLAConditionalLine{\HLAArial\fontsize{10.98bp}{12.63bp}\selectfont\bfseries\mbox{#1}}\par}}
\newcommand{\HLAMinorClauseHeading}[1]{{\color{RLBlueDeep}\HLAConditionalLine{\HLAArial\fontsize{9.96bp}{11.45bp}\selectfont\bfseries\mbox{#1}}\par}}
\newcommand{\HLADefinitionBlock}[2]{\textbf{#1:} \HLAStableBlockText{#2}\par}
\newcommand{\HLAClauseParagraph}[1]{\HLAStableBlockText{#1}\par}
\newcommand{\HLAClauseFootnote}[1]{{\HLAFootnoteFont #1\par}}
\newcommand{\HLAClauseRunningHeader}{}

% Clause pages need the running header to precede the printed-page/copyright
% furniture in PDF content-stream order. This preserves source extraction order
% while leaving all furniture at its fixed visual coordinates.
\NewDocumentEnvironment{HLAClauseSemanticPage}{m}{%
    \begin{HLASemanticPage}%
    \HLAClauseRunningHeader%
    \HLAStandardFooter{#1}%
}{%
    \end{HLASemanticPage}%
}

\NewDocumentCommand{\HLAPlacedImage}{m m m m m}{%
    \IfFileExists{#5}{%
        \par\noindent
        \begin{tikzpicture}[
            remember picture,overlay,shift={(current page.north west)},x=1bp,y=-1bp
        ]
        \node[anchor=north west,inner sep=0bp,outer sep=0bp]
        at (#1,#2) {\includegraphics[width=#3bp,height=#4bp]{#5}};
        \end{tikzpicture}%
        \par\vspace{-\baselineskip}%
    }{}
}

% The OMT Glyph category uses a small abstract object-model mark. Keep it
% live TikZ so it remains crisp, portable, and independent of source images.
\NewDocumentCommand{\HLAObjectModelGlyphAt}{m m m m}{%
    \par\noindent
    \pgfmathsetmacro{\HLAObjectGlyphXScale}{#3/24}%
    \pgfmathsetmacro{\HLAObjectGlyphYScale}{#4/24}%
    \begin{tikzpicture}[
        remember picture,overlay,shift={(current page.north west)},x=1bp,y=-1bp
    ]
    \begin{scope}[shift={(#1,#2)},xscale=\HLAObjectGlyphXScale,yscale=\HLAObjectGlyphYScale]
        \draw[RLLine,line width=.45bp] (1.5,1.5) rectangle (22.5,22.5);
        \draw[RLBlue,line width=.8bp] (4,15) -- (10,7.5) -- (16,12) -- (20,5);
        \draw[RLBlue,line width=.55bp] (10,7.5) -- (10,19) (16,12) -- (16,19);
        \fill[RLOrange] (4,15) circle (1.35);
        \fill[RLOrange] (10,7.5) circle (1.35);
        \fill[RLBlue] (16,12) circle (1.35);
        \fill[RLBlue] (20,5) circle (1.35);
    \end{scope}
    \end{tikzpicture}%
    \par\vspace{-\baselineskip}%
}

\newcommand{\HLAClauseDashItem}[1]{%
    \begingroup
    \hfuzz=2.2pt%
    \setlength{\parindent}{0pt}%
    \hangindent=22bp%
    \hangafter=1%
    \makebox[22bp][l]{—}\HLAStableBlockText{#1}\par
    \endgroup
}

\newcommand{\HLAClauseLabeledItem}[2]{%
    \begingroup
    \hfuzz=2.2pt%
    \setlength{\parindent}{0pt}%
    \hangindent=22bp%
    \hangafter=1%
    \makebox[22bp][l]{#1}\HLAStableBlockText{#2}\par
    \endgroup
}

% Abbreviation and acronym rows use a stable 50 bp label column. This
% reproduces the source alignment while retaining ordinary extractable text.
\NewDocumentCommand{\HLAAcronymRow}{m m}{%
    \begingroup
    \setlength{\parindent}{0pt}%
    \makebox[50bp][l]{#1}#2\par
    \endgroup
}
