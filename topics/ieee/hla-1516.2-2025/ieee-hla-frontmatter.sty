\NewDocumentEnvironment{HLATitlePage}{}{%
  \begin{HLASemanticPage}
  \HLAStableID{front.title-page}%
  \HLAArial%
}{%
  \end{HLASemanticPage}%
}

\NewDocumentEnvironment{HLAPublicationPage}{}{%
  \begin{HLASemanticPage}
