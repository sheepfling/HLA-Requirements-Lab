\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ieee-hla-annexes}[2026/07/31 v1.0.1 IEEE HLA recreation annex structures]

\providecommand{\HLAAnnexHeading}[1]{{%
    \HLAConditionalLine{\HLAArial\fontsize{13.98bp}{16.08bp}\selectfont\bfseries\mbox{#1}}\par
}}

\providecommand{\HLAAnnexStatus}[1]{{%
    \HLAConditionalLine{\HLAArial\fontsize{12bp}{13.8bp}\selectfont #1}\par
}}

\providecommand{\HLAAnnexTitle}[1]{{%
    \HLAConditionalLine{\HLAArial\fontsize{13.98bp}{16.08bp}\selectfont\bfseries\mbox{#1}}\par
}}

\providecommand{\HLAAnnexSubclauseHeading}[1]{{%
    \HLAConditionalLine{\HLAArial\fontsize{12bp}{13.8bp}\selectfont\bfseries\mbox{#1}}\par
}}

\providecommand{\HLAAnnexFittedSubclauseHeading}[2]{{%
    \HLAArial\fontsize{12bp}{13.8bp}\selectfont\bfseries
    \resizebox{#1}{!}{\mbox{#2}}\par
}}

\RequirePackage{xparse}

\NewDocumentCommand{\HLAAnnexFieldBlock}{+m}{#1\par}
