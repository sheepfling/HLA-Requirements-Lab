\newcommand{\clause}[1]{%
    \par\vspace{10.0pt}%
    {\sffamily\bfseries\fontsize{12pt}{14.4pt}\selectfont #1\par}%
    \vspace{7.5pt}%
}
\newcommand{\subclause}[1]{%
    \par\vspace{8.0pt}%
    {\sffamily\bfseries\fontsize{10.98pt}{13.2pt}\selectfont #1\par}%
    \vspace{6.0pt}%
}
\newcommand{\subsubclause}[1]{%
    \par\vspace{7.0pt}%
    {\sffamily\bfseries\fontsize{9.96pt}{12pt}\selectfont #1\par}%
    \vspace{5.0pt}%
}

\newcommand{\hlaNote}[1]{%
    \par\vspace{0pt}{\notefont NOTE---#1\par}\vspace{0pt}%
}

\newcommand{\defentry}[2]{%
    \par\noindent\textbf{#1:} #2\par
}
\newcommand{\hlaService}[1]{\textit{#1}}
\newcommand{\hlaSeeAlso}[1]{\textit{See also}: #1}
\newcommand{\hlaTermRef}[1]{\textbf{#1}}

\newenvironment{hlalist}{%
    \begin{enumerate}[label=\alph*),labelindent=10pt,labelwidth=8pt,labelsep=14pt,leftmargin=32pt,itemsep=0pt,topsep=2pt,parsep=0pt,partopsep=0pt]
}{\end{enumerate}}

\newenvironment{hlarules}{%
% Clause 4 source geometry: labels begin at x ~= 122 pt and text at
% x ~= 142 pt on the 90 pt technical-body left margin.  The source has
% no inter-item gap beyond the 12 pt body leading and uses one blank line
% above and below each rule list.
    \begin{enumerate}[label=\arabic*),leftmargin=52pt,labelsep=11.6pt,itemsep=0pt,topsep=6pt,parsep=0pt,partopsep=0pt]
}{\end{enumerate}}


% Informative annex headings.  These are kept separate from clause headings
% because the source uses a visibly looser, larger title stack on annex pages.
\newcommand{\annexdesignation}[1]{%
    \par\vspace{8pt}%
    {\sffamily\bfseries\fontsize{14.4pt}{17.2pt}\selectfont Annex #1\par}%
    \vspace{13pt}%
}
\newcommand{\annexstatus}[1]{%
        {\fontsize{12pt}{14.4pt}\selectfont (#1)\par}%
    \vspace{18pt}%
}
\newcommand{\annextitle}[1]{%
        {\sffamily\bfseries\fontsize{14.4pt}{17.2pt}\selectfont #1\par}%
    \vspace{20pt}%
}
\newcommand{\annexsection}[1]{%
    \par\vspace{7pt}%
    {\sffamily\bfseries\fontsize{11.0pt}{13.2pt}\selectfont #1\par}%
    \vspace{8pt}%
}
\newcommand{\annexsubsection}[1]{%
    \par\vspace{8pt}%
    {\sffamily\bfseries\fontsize{10.0pt}{12pt}\selectfont #1\par}%
    \vspace{7pt}%
}

\AtBeginDocument{\bodyfont\justifying}

% Technical-body baseline/footer calibration. Shrinking the text area by 9 pt
% raises bottom-anchored footnotes to the source position; increasing footskip by
% the same amount keeps the running footer at its calibrated physical baseline.
\newcommand{\hlaTechnicalMetrics}{%
    \addtolength{\textheight}{-9pt}%
    \addtolength{\footskip}{9pt}%
}

