% The final bibliography page in the supplied 2010 PDF uses a reduced running
% header and sits its folio/copyright line slightly lower than the technical
% body page style. Keep this isolated so earlier reconstructed pages do not
% reflow while the front matter remains deferred.
\fancypagestyle{hlabibliography}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
    \fancyhead[LE]{\raisebox{10.3pt}[0pt][0pt]{\headerfont IEEE Std 1516-2010}}
    \fancyfoot[LE]{\hspace*{-1pt}\raisebox{-8.6pt}[0pt][0pt]{\footerfont\thepage}}
    \fancyfoot[RE]{\raisebox{-10.2pt}[0pt][0pt]{\sffamily\fontsize{7.98pt}{9.2pt}\selectfont Copyright \textcopyright\ 2010 IEEE. All rights reserved.}}
    \ifShowLicenseFooter
    \fancyfoot[C]{\raisebox{-34.4pt}[0pt][0pt]{\makebox[0pt][c]{\licensefont\licensefootertext}}}
    \fi
}

% First Arabic technical page (source PDF page 13 / printed page 1).
% \hlaTechnicalMetrics is invoked after \begin{document}; TeX's first page has
% already initialized its output box at that point, so its footer needs a
% page-specific 9--11 pt lift to occupy the same physical baseline as later
% technical pages.  Keep that correction isolated here rather than perturbing
% the already-calibrated pages 2--26.
\fancypagestyle{hlafirst}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
    \fancyfoot[LO]{\hspace*{-1pt}\raisebox{-0.5pt}[0pt][0pt]{\footerfont Copyright \textcopyright\ 2010 IEEE. All rights reserved.}}
    \fancyfoot[RO]{\raisebox{1.2pt}[0pt][0pt]{\footerfont\thepage}}
    \ifShowLicenseFooter
    \fancyfoot[C]{\raisebox{-23.3pt}[0pt][0pt]{\makebox[0pt][c]{\hspace*{-2.3pt}\licensefont\licensefootertext}}}
    \fi
}

