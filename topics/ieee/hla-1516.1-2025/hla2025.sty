\newcommand{\HLAAnchor}[1]{\hypertarget{#1}{}}
\newcommand{\HLASourcePage}[2]{%
    \thispdfpagelabel{#2}%
    \HLAAnchor{source-pdf-page-#1}%
    \gdef\HLACurrentSourcePDFPage{#1}%
    \gdef\HLACurrentSourcePageLabel{#2}%
}

\DeclareCaptionLabelSeparator{emdash}{---}
\captionsetup{font={sf,bf},labelfont={sf,bf},labelsep=emdash,justification=centering,singlelinecheck=false}


% Fixed-position source-page helpers used for front matter whose source layout is
% explicitly page-composed. Text remains native and searchable; no page image is
% used as a background.
\newenvironment{hlafixedpage}{%
    \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={(current page.north west)},x=1pt,y=-1pt]
}{%
    \end{scope}
    \end{tikzpicture}%
    \mbox{}%
}

\newcommand{\HLAFixedBlock}[7]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        \RaggedRight #4\fontsize{#5pt}{#6pt}\selectfont\setlength{\parindent}{0pt}#7\par
        \end{minipage}%
    };%
}

\newcommand{\HLAFixedImage}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \includegraphics[width=#3pt,height=#4pt]{#5}%
    };%
}

\newcommand{\HLAFixedCenteredBlock}[7]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        #4\fontsize{#5pt}{#6pt}\selectfont\centering #7\par
        \end{minipage}%
    };%
}

% Raw portrait-page text line for source pages carrying a PDF /Rotate 90 entry.
% The line is written bottom-to-top in page space and becomes left-to-right when
% a conforming viewer applies the page rotation.
\newcommand{\HLARotatedLine}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt,rotate=90] at (#1,#2) {%
            {#3\fontsize{#4pt}{#4pt}\selectfont #5}%
    };%
}

% Searchable but visually suppressed source text. Some IEEE figure captions
% contain a second non-rendering text object in the source PDF; preserving it
% keeps token-level extraction faithful without duplicating the visible caption.
\newcommand{\HLAInvisibleFixedCenteredBlock}[7]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        #4\fontsize{#5pt}{#6pt}\selectfont\centering
        \special{pdf:literal direct 3 Tr}#7\special{pdf:literal direct 0 Tr}\par
        \end{minipage}%
    };%
}

\newcommand{\HLATocLineAt}[7]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#2,#1) {%
            {\rmfamily\fontsize{9.96pt}{12pt}\selectfont #3}%
    };%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#4,#1) {%
            {\rmfamily\fontsize{9.96pt}{12pt}\selectfont
        \makebox[#6pt][l]{#5\leaders\hbox{.}\hfill}}%
    };%
    \node[anchor=north east,inner sep=0pt,outer sep=0pt] at (522,#1) {%
            {\rmfamily\fontsize{9.96pt}{12pt}\selectfont #7}%
    };%
}

\newcommand{\HLASupMark}[1]{\raisebox{2.0pt}{\fontsize{6.36pt}{7pt}\selectfont #1}}

\newcommand{\HLATocHeadingAt}[1]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (90,#1) {%
            {\sffamily\bfseries\fontsize{12pt}{14pt}\selectfont Contents}%
    };%
}

% Fixed-position semantic dash list for body pages. The minipage origin is
% expressed in source-page coordinates while the contents remain a native
% itemize structure.
\newcommand{\HLAFixedDashList}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        \hfuzz=1.5pt%
        \rmfamily\fontsize{9.96pt}{12pt}\selectfont\RaggedRight
        \begin{itemize}[
            label=---,
            leftmargin=32pt,
            labelwidth=10pt,
            labelsep=12pt,
            align=left,
            itemsep=#4pt,
            topsep=0pt,
            parsep=0pt,
            partopsep=0pt
        ]
        #5
        \end{itemize}
        \end{minipage}%
    };%
}

% Clause 3 definition helpers. These retain semantic term boundaries while
% allowing source-page line breaks and coordinates to remain explicit.
\newcommand{\HLADefinitionAnchor}[1]{\HLAAnchor{definition:#1}}
\newcommand{\HLADefinitionTerm}[1]{\textbf{#1}}
\newcommand{\HLASeeAlso}[1]{\emph{See also}: \textbf{#1}}
\newcommand{\HLADefinitionAt}[2]{%
    \HLAFixedBlock{90}{#1}{432}{\rmfamily}{9.96}{12}{#2}%
}
\newcommand{\HLADefinitionNoteAt}[3]{%
    \HLAFixedBlock{#1}{#2}{432}{\rmfamily\raggedright}{9}{12}{#3}%
}
\newcommand{\HLAFixedAlphaList}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        \hfuzz=1.5pt%
        \rmfamily\fontsize{9.96pt}{12pt}\selectfont\RaggedRight
        \begin{enumerate}[
            label=\alph*),
            leftmargin=22pt,
            labelwidth=8pt,
            labelsep=14pt,
            align=left,
            itemsep=#4pt,
            topsep=0pt,
            parsep=0pt,
            partopsep=0pt
        ]
        #5
        \end{enumerate}
        \end{minipage}%
    };%
}

% Fixed-position alphabetic list starting at an arbitrary source label. This is
% useful where source notes interrupt a multi-sense definition between items.
\newcommand{\HLAFixedAlphaListFrom}[6]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \begin{minipage}[t]{#3pt}%
        \vspace{0pt}%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{0pt}%
        \hbadness=10000%
        \hfuzz=1.5pt%
        \rmfamily\fontsize{9.96pt}{12pt}\selectfont\justifying
        \begin{enumerate}[
            label=\alph*),
            start=#5,
            leftmargin=22pt,
            labelwidth=8pt,
            labelsep=14pt,
            align=left,
            itemsep=#4pt,
            topsep=0pt,
            parsep=0pt,
            partopsep=0pt
        ]
        #6
        \end{enumerate}
        \end{minipage}%
    };%
}

% Clause 3.2 semantic two-column abbreviation rows. Each row retains a stable
% anchor while matching the source's independently aligned columns.
\newcommand{\HLAAbbreviationAnchor}[1]{\HLAAnchor{abbreviation:#1}}
\newcommand{\HLAAbbreviationAt}[4]{%
    \HLAFixedBlock{90}{#2}{50}{\rmfamily\raggedright}{9.96}{12}{\HLAAbbreviationAnchor{#1}#3}%
    \HLAFixedBlock{140}{#2}{382}{\rmfamily\raggedright}{9.96}{12}{#4}%
}

% Provenance-tracked figure helpers for body pages. The extracted source asset
% remains at the exact source-page rectangle while the caption stays native and
% searchable. Figure anchors are independent of the raster asset.
\newcommand{\HLAFigureAnchor}[1]{\HLAAnchor{figure:#1}}
\newcommand{\HLAFigureImageAt}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \includegraphics[width=#3pt,height=#4pt]{#5}%
    };%
}
% Generated diagram helper. The semantic build supplies a TikZ input file and
% constrains it to the source figure rectangle without introducing a binary
% analogue into the faithful build.
\newcommand{\HLAEmbeddedTikZAt}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \resizebox{#3pt}{#4pt}{#5}%
    };%
}
\newcommand{\HLAEmbeddedGraphicAt}[5]{%
    \node[anchor=north west,inner sep=0pt,outer sep=0pt] at (#1,#2) {%
        \includegraphics[width=#3pt,height=#4pt,keepaspectratio]{#5}%
    };%
}
\newcommand{\HLAFigureCaptionAt}[3]{%
    \HLAFixedCenteredBlock{90}{#2}{432}{\sffamily\bfseries}{9.96}{12}{%
        \HLAFigureAnchor{#1}Figure #1---#3%
    }%
}

% Modern figure-only pages use true landscape media dimensions.  The diagram
% remains a selectable TikZ surface and receives its caption here exactly once;
% no source-page masthead, folio, or rotated caption is carried into the page.
\newcommand{\HLALandscapeFigurePage}[3]{%
    \begin{RLLandscapePage}
        \thispagestyle{rl}%
        \HLAFigureAnchor{#1}%
        \vspace*{2pt}%
        {\RLFixedSans\bfseries\fontsize{10.5pt}{12.5pt}\selectfont\color{RLBlueDeep}%
            FIGURE~#1\enspace\textcolor{RLMid}{/}\enspace #2\par}%
        \vspace{7pt}%
        \begin{center}
            \resizebox{0.995\linewidth}{!}{\input{#3}}%
        \end{center}%
        \vspace{3pt}%
        {\RLFixedSans\fontsize{7.6pt}{9.2pt}\selectfont\color{RLMid}%
            Figure~#1---#2\par}%
    \end{RLLandscapePage}%
}
\newcommand{\HLALandscapeFigurePDFPage}[3]{%
    \begin{RLLandscapePage}
        \thispagestyle{rl}%
        \HLAFigureAnchor{#1}%
        \vspace*{2pt}%
        {\RLFixedSans\bfseries\fontsize{10.5pt}{12.5pt}\selectfont\color{RLBlueDeep}%
            FIGURE~#1\enspace\textcolor{RLMid}{/}\enspace #2\par}%
        \vspace{7pt}%
        \begin{center}
            \includegraphics[width=0.995\linewidth,height=0.90\textheight,keepaspectratio]{#3}%
        \end{center}%
        \vspace{3pt}%
        {\RLFixedSans\fontsize{7.6pt}{9.2pt}\selectfont\color{RLMid}%
            Figure~#1---#2\par}%
    \end{RLLandscapePage}%
}

\newcommand{\HLAServiceDirectionFor}[1]{%
    \begingroup
    \edef\HLAServiceDirectionText{\detokenize{#1}}%
    \IfSubStr{\HLAServiceDirectionText}{textdagger}%
        {RTI $\rightarrow$ FEDERATE}%
        {FEDERATE $\rightarrow$ RTI}%
    \endgroup
}

% Clause 4 service-description helpers. Service and component headings share
% fixed source-page geometry while retaining stable clause anchors and outline
% destinations. The body remains explicit fixed-position native text.
\newcommand{\HLAServiceBookmark}[3]{%
    \HLAAnchor{clause:#1}%
    \pdfbookmark[#2]{#1 #3}{bookmark:clause:#1}%
}
\newcommand{\HLAServiceHeadingAt}[2]{%
    \HLAFixedBlock{90}{#1}{432}{\sffamily\bfseries\raggedright}{10.98}{12}{%
        \makebox[\linewidth][l]{#2\hfill{\color{HLALabPurple}\fontsize{7.2pt}{8.4pt}\selectfont
        \HLAServiceDirectionFor{#2}}}%
    }%
}
\newcommand{\HLAServiceComponentHeadingAt}[2]{%
    \HLAFixedBlock{90}{#1}{432}{\sffamily\bfseries\raggedright}{8.8}{10.6}{#2}%
}

% Reusable natural-flow grammar for the interface contract pages.  This is
% intentionally a quiet aligned contract, not a collection of web-style
% cards: the repeated service fields remain explicit and searchable while the
% small tracked labels reduce visual repetition.
\newenvironment{HLAServiceContract}[2]{%
    \par\medskip\noindent
    \begin{minipage}{\linewidth}
    \HLAServiceContractHeading{#1}{#2}%
}{%
    \end{minipage}\par\medskip
}
\newcommand{\HLAServiceContractHeading}[2]{%
    \par\noindent
    {\RLSans\bfseries\fontsize{11.2pt}{13.2pt}\selectfont\color{RLBlueDeep}#1}%
    \hfill
    {\RLSans\fontsize{7.4pt}{9pt}\selectfont\addfontfeatures{LetterSpace=1.0}\color{RLBlue}\MakeUppercase{#2}}%
    \par\vspace{4pt}\noindent{\color{RLLine}\rule{\linewidth}{0.55pt}}\par\vspace{4pt}%
}
\newcommand{\HLAServiceContractSection}[1]{%
    \par\smallskip\noindent
    {\RLSans\bfseries\fontsize{7.3pt}{8.8pt}\selectfont\addfontfeatures{LetterSpace=1.0}\color{RLBlue}\MakeUppercase{#1}}%
    \par\vspace{1.5pt}%
}
\newenvironment{HLAServiceContractList}{%
    \begin{enumerate}[label=\alph*),leftmargin=22pt,labelsep=8pt,itemsep=2.5pt,topsep=0pt,parsep=0pt]
}{%
    \end{enumerate}
}
\newcommand{\HLAFixedRule}[4]{%
    \begin{tikzpicture}[remember picture,overlay]
    \fill[black] ([xshift=#1pt,yshift=-#2pt]current page.north west) rectangle ++(#3pt,-#4pt);
    \end{tikzpicture}%
}
